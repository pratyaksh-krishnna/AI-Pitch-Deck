# Neon Postgres — Neon console → your project → Connect.
# Use the *direct* connection string (host without "-pooler"); Prisma migrate needs it.
# Example: postgresql://USER:PASSWORD@ep-xxxx-xxxx.REGION.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=

# OpenAI — https://platform.openai.com/api-keys (used for the agent + slide images)
OPENAI_API_KEY=

# ImageKit — dashboard → Developer options → Private key
IMAGEKIT_PRIVATE_KEY=

# Set to "true" to skip OpenAI image generation (saves cost while testing the UI)
USE_PLACEHOLDER_IMAGES=true

# Inngest — local dev: keep INNGEST_DEV=1 and run `pnpm inngest:dev`.
# Production: remove INNGEST_DEV and set the two keys below.
INNGEST_DEV=1
# INNGEST_EVENT_KEY=
# INNGEST_SIGNING_KEY=

# Anthropic — https://console.anthropic.com → API keys (Slide Builder)
ANTHROPIC_API_KEY=

# DECK_SLIDE_LIMIT=2  # optional: build only the first N sections (dev cost cap)
